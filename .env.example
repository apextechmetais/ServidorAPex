# Copie para .env ao rodar localmente (nao commitar o .env de verdade)
SECRET_KEY=troque-por-uma-chave-aleatoria-grande

DATABASE_URL=sqlite:///local.db
UPLOAD_FOLDER=./uploads

# URL publica do ApexAmostra para login federado (deixe vazio para desativar)
# Exemplo: https://apexamostra-production-xxxx.up.railway.app
APEX_AMOSTRA_URL=

# Acesso de administrador (criado/atualizado a cada início do servidor)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=troque-por-uma-senha-forte
ADMIN_NOME=Administrador

# Endereço do painel (link "Voltar ao painel")
PAINEL_URL=https://apextechmetais.com.br/admin.html

# Alertas de vencimento por e-mail (Resend, o mesmo serviço do painel; funciona no Railway)
RESEND_API_KEY=
MAIL_FROM=Apextech Metais <noreply@apextechmetais.com.br>
# Endereço público deste sistema, para os links dentro do e-mail
APP_URL=https://SEU-APP.up.railway.app
